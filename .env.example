# Copie para .env e ajuste o que quiser.

# --- Cérebro (LLM) ---
# pollinations (grátis, sem chave) | ollama | groq | gemini | custom
LIA_PROVIDER=pollinations
LIA_FALLBACK=ollama

# Pollinations: modelo público. Deixe "openai" para o padrão.
LIA_MODEL=openai

# Ollama local (ilimitado). Rode: ollama pull qwen2.5:3b
# LIA_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_URL=http://localhost:11434/v1/chat/completions

# Groq (plano gratuito): https://console.groq.com/keys
# LIA_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (plano gratuito): https://aistudio.google.com/apikey
# LIA_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Qualquer endpoint compatível com OpenAI (LM Studio, vLLM, ...)
# LIA_PROVIDER=custom
# LIA_BASE_URL=http://localhost:1234/v1/chat/completions
# LIA_API_KEY=none

# --- Personalidade ---
# LIA_PERSONA=Você é a Lia, ...

# --- Voz (Kokoro) ---
LIA_VOZ=pf_dora
# pf_dora (feminina), pm_alex, pm_santa
LIA_VELOCIDADE=1.0

# --- Totem de feira (modo padrão, sem microfone) ---
# totem | microfone | texto
# LIA_MODO=totem
LIA_PERGUNTAS=perguntas.json

# Página do celular (QR code no totem)
LIA_WEB=1
LIA_WEB_PORT=8765
# URL pública opcional (ex.: túnel Cloudflare). Em branco = IP da rede local.
# LIA_WEB_URL=https://exemplo.trycloudflare.com

# Volta ao descanso depois de N segundos sem interação
LIA_INATIVIDADE=90

# Cumprimenta quando a webcam detectar um rosto
LIA_CAMERA=0
LIA_CAMERA_INDICE=0
LIA_SAUDACAO=1

# Voz do totem (0 = só texto, não carrega o Kokoro)
LIA_AUDIO=1

# --- Escuta (Whisper, só no modo --microfone) ---
# base | small | medium
LIA_WHISPER=small
LIA_LANG=pt
LIA_SILENCIO=0.8
LIA_MAX_FALA=20
LIA_MIC_GAIN=1.0

# --- Interface ---
LIA_LARGURA=1280
LIA_ALTURA=800
LIA_ESCALA=2
LIA_FULLSCREEN=0
LIA_AUTO_ESCUTA=1

# --- Limites do LLM ---
LIA_TEMPERATURE=0.7
LIA_MAX_TOKENS=320
LIA_HISTORY=8
